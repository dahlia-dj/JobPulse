# Copier ce fichier en .env puis remplir les valeurs avant de lancer docker compose.
# Ne jamais committer le fichier .env réel (voir .gitignore).

# ---------- Airflow ----------
# Sous Linux/Mac : exécuter `id -u` et mettre le résultat ici pour éviter les
# problèmes de permissions sur les volumes montés. Sous Windows/WSL, laisser 50000.
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=PFE
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------- PostgreSQL (2 bases : métadonnées Airflow + entrepôt Gold) ----------
POSTGRES_USER=pg_admin
POSTGRES_PASSWORD=postgres237
POSTGRES_AIRFLOW_DB=airflow
POSTGRES_DWH_DB=job_offers_dwh

# ---------- MinIO (data lake Bronze) ----------
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio237
MINIO_BUCKET_BRONZE=job-offers-bronze
MINIO_BUCKET_SILVER=job-offers-silver
MINIO_ENDPOINT=minio:9000

# ---------- France Travail API ----------
